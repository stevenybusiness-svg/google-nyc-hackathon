# ============================================================
# Environment Variables — copy this file to .env and fill in
# your own keys. Never commit .env to git.
#
#   cp .env.example .env
#
# ============================================================

# Required — Google AI Studio API key
# Get yours at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gradium TTS/STT — fallback when Gemini Live is recovering
# Available voices: English, French, Spanish, German, Portuguese
# Get your key at: https://gradium.ai
GRADIUM_API_KEY=your_gradium_api_key_here
