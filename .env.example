# Required — get from https://aistudio.google.com/apikey
# Make sure this key was created in the same GCP project as GOOGLE_CLOUD_PROJECT
GOOGLE_API_KEY=your_google_api_key_here

# Required — GCP project where APIs are enabled
# Find it: gcloud config get-value project  (or top of GCP Console)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Optional — fallback TTS/STT
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Optional — tertiary fallback
GRADIUM_API_KEY=your_gradium_key_here
